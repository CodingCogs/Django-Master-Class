# --- Django ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Postgres (read by the db container and by compose interpolation) ---
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore-dev-password
# Used when Django runs on the host. The web container overrides the host part.
DATABASE_URL=postgres://bookstore:bookstore-dev-password@localhost:5432/bookstore

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-dev-password

# --- Django media storage ---
USE_S3=True
S3_BUCKET=bookstore-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-dev-password
# Where Django talks to MinIO. The web container overrides this to http://minio:9000.
S3_ENDPOINT_URL=http://localhost:9000
# What the browser uses to load files. Always the host address.
S3_PUBLIC_DOMAIN=localhost:9000/bookstore-media
